        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox necesita acceso a tu biblioteca de fotos para mostrar fotos para revisar y guardar favoritos en un álbum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox a besoin d'accéder à votre photothèque pour afficher les photos à réviser et enregistrer les favoris dans un album."

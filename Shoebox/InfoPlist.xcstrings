        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox は写真をレビュー用に表示し、お気に入りをアルバムに保存するために写真ライブラリへのアクセスが必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox는 리뷰할 사진을 표시하고 즐겨찾기를 앨범에 저장하기 위해 사진 라이브러리에 접근해야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "O Kondobox precisa de acesso à sua biblioteca de fotos para exibir fotos para revisão e salvar favoritos em um álbum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox необходим доступ к вашей фотобиблиотеке для отображения фотографий на рассмотрение и сохранения избранных в альбом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",

    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kondobox benötigt Zugriff auf deine Fotobibliothek, um Fotos zur Überprüfung anzuzeigen und Favoriten in einem Album zu speichern."

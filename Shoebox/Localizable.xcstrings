    "Marks the photo as a Favorite in your library. Favorited photos won't appear in future reviews." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markiert das Foto als Favorit in deiner Bibliothek. Favorisierte Fotos erscheinen nicht mehr bei zukünftigen Überprüfungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca la foto como Favorita en tu biblioteca. Las fotos en Favoritos no aparecerán en futuras revisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque la photo comme Favorite dans votre photothèque. Les photos en Favoris n'apparaîtront plus dans les examens futurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna la foto come Preferita nella tua libreria. Le foto preferite non compariranno nelle revisioni future."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真をライブラリでお気に入りに設定します。お気に入りの写真は今後のレビューには表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "라이브러리에서 사진을 즐겨찾기로 표시합니다. 즐겨찾기에 추가된 사진은 이후 검토에 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca a foto como Favorita na sua biblioteca. Fotos favoritadas não aparecerão em revisões futuras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает фото как Избранное в библиотеке. Избранные фото не будут показываться в будущих просмотрах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将照片标记为照片库中的收藏。已收藏的照片不会在以后的审阅中出现。"

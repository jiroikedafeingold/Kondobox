          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас есть фото, ожидающие просмотра. Пролистайте несколько фото, чтобы поддерживать порядок в библиотеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",

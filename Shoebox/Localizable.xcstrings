    "Declutter your photo library with simple swipe gestures. Review 20 photos each week and keep your memories organized." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Räume deine Fotobibliothek mit einfachen Wischgesten auf. Überprüfe jede Woche 20 Fotos und halte deine Erinnerungen organisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organiza tu biblioteca de fotos con gestos simples. Revisa 20 fotos cada semana y mantén tus recuerdos en orden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangez votre photothèque avec de simples gestes de balayage. Examinez 20 photos par semaine et gardez vos souvenirs bien organisés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riordina la tua libreria foto con semplici gesti di scorrimento. Rivedi 20 foto ogni settimana e tieni i tuoi ricordi in ordine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シンプルなスワイプ操作で写真ライブラリを整理しましょう。毎週20枚の写真をレビューして、思い出を整理整頓。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "간단한 스와이프 제스처로 사진 라이브러리를 정리하세요. 매주 20장의 사진을 검토하고 추억을 깔끔하게 관리하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize sua biblioteca de fotos com gestos simples. Revise 20 fotos por semana e mantenha suas memórias em ordem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наведите порядок в фотобиблиотеке простыми жестами смахивания. Просматривайте 20 фото в неделю и держите воспоминания в порядке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过简单的滑动手势整理你的照片库。每周审阅 20 张照片，让你的回忆井井有条。"
          }
        }
      }
    },

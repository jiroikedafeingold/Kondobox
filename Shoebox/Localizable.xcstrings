    "Great taste! Those favorites are keepers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guter Geschmack! Diese Favoriten sind echte Schätze."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Buen gusto! Esos favoritos son para guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bon goût ! Ces favoris sont de vrais trésors."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottimo gusto! Quei preferiti sono dei veri tesori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "センス抜群！お気に入りは大切に保管されます。"

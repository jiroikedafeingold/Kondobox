    "Get a gentle reminder each week to review your photos. You can change this later in Settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte jede Woche eine sanfte Erinnerung, deine Fotos zu überprüfen. Du kannst dies später in den Einstellungen ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe un recordatorio semanal para revisar tus fotos. Puedes cambiarlo después en Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recevez un rappel chaque semaine pour examiner vos photos. Vous pourrez modifier cela plus tard dans les Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi un promemoria settimanale per rivedere le tue foto. Puoi modificarlo in seguito nelle Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎週やさしいリマインダーで写真のレビューを思い出しましょう。後から設定で変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매주 사진 검토 알림을 받으세요. 나중에 설정에서 변경할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba um lembrete semanal para revisar suas fotos. Você pode alterar isso depois nos Ajustes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте еженедельное напоминание о просмотре фотографий. Вы можете изменить это позже в Настройках."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每周收到温馨提醒来审阅你的照片。你可以稍后在设置中更改。"
          }
        }
      }
    },

    "Saves the photo to your \"%@\" album. The photo stays in your library and is also added to the album." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sichert das Foto in deinem Album «%@». Das Foto bleibt in deiner Bibliothek und wird auch dem Album hinzugefügt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda la foto en tu álbum \"%@\". La foto permanece en tu biblioteca y también se añade al álbum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre la photo dans votre album « %@ ». La photo reste dans votre photothèque et est également ajoutée à l'album."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva la foto nel tuo album \"%@\". La foto rimane nella tua libreria e viene anche aggiunta all'album."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真を「%@」アルバムに保存します。写真はライブラリに残り、アルバムにも追加されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" 앨범에 사진을 저장합니다. 사진은 라이브러리에 유지되며 앨범에도 추가됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva a foto no seu álbum \"%@\". A foto permanece na sua biblioteca e também é adicionada ao álbum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сохраняет фото в альбом «%@». Фото остаётся в библиотеке и также добавляется в альбом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将照片保存到你的\"%@\"相簿。照片会保留在你的照片库中，同时也会添加到该相簿。"
          }
        }
      }
    },

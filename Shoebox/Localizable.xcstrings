    "Keeps the photo in your library as-is and moves to the next one. It won't be shown again in future reviews." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behält das Foto so wie es ist in deiner Bibliothek und geht zum nächsten weiter. Es wird bei zukünftigen Überprüfungen nicht mehr angezeigt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conserva la foto en tu biblioteca tal cual y pasa a la siguiente. No se mostrará de nuevo en futuras revisiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Garde la photo dans votre photothèque telle quelle et passe à la suivante. Elle ne sera plus affichée dans les examens futurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantiene la foto nella tua libreria così com'è e passa alla successiva. Non verrà più mostrata nelle revisioni future."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真をそのままライブラリに残し、次の写真に進みます。今後のレビューでは表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진을 라이브러리에 그대로 유지하고 다음 사진으로 넘어갑니다. 이후 검토에서 다시 표시되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém a foto na sua biblioteca como está e passa para a próxima. Ela não será mostrada novamente em revisões futuras."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставляет фото в библиотеке без изменений и переходит к следующему. Оно больше не будет показываться при просмотре."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保留照片在你的照片库中不做更改，并继续下一张。在以后的审阅中不会再显示。"
          }
        }
      }
    },

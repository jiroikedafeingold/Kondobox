    "%lld photos reviewed so far.\nResetting lets you see previously reviewed photos again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Fotos bisher überprüft.\nDurch Zurücksetzen kannst du bereits überprüfte Fotos erneut sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld fotos revisadas hasta ahora.\nRestablecer te permite volver a ver las fotos revisadas anteriormente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld photos examinées jusqu'à présent.\nRéinitialiser vous permet de revoir les photos déjà examinées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld foto revisionate finora.\nIl ripristino ti consente di rivedere le foto già esaminate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでに %lld 枚の写真をレビューしました。\nリセットすると、以前レビューした写真を再度表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금까지 %lld장의 사진을 검토했습니다.\n초기화하면 이전에 검토한 사진을 다시 볼 수 있습니다."

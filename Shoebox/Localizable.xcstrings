    "Set up reminders in Settings to get notified when it's time to review your photos." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte Erinnerungen in den Einstellungen ein, um benachrichtigt zu werden, wenn es Zeit ist, deine Fotos zu überprüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura recordatorios en Ajustes para recibir notificaciones cuando sea hora de revisar tus fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez des rappels dans les Réglages pour être notifié quand il est temps d'examiner vos photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura i promemoria nelle Impostazioni per ricevere notifiche quando è il momento di rivedere le tue foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でリマインダーを設定すると、写真をレビューする時間に通知を受け取れます。"
          }
        },
        "ko" : {

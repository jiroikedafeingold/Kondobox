    "Open the Photos app, go to Albums, and scroll to the bottom to find the Recently Deleted folder." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne die Fotos-App, gehe zu Alben und scrolle nach unten, um den Ordner «Zuletzt gelöscht» zu finden."
          }
        },
        "es" : {

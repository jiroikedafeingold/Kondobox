    "You can also tap the action buttons below the photo instead of swiping." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst auch die Aktionsschaltflächen unter dem Foto antippen, anstatt zu wischen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes tocar los botones de acción debajo de la foto en lugar de deslizar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi appuyer sur les boutons d'action sous la photo au lieu de balayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",

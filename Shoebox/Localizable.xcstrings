    "Kondobox" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kondobox"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kondobox"
          }
        },
        "fr" : {
          "stringUnit" : {

        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "검토를 기다리는 사진이 있습니다. 사진을 스와이프하여 라이브러리를 깔끔하게 유지하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

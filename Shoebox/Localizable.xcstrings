    "You have photos waiting for review. Swipe through some photos to keep your library clean." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es warten Fotos auf Überprüfung. Wische durch einige Fotos, um deine Bibliothek sauber zu halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tienes fotos esperando revisión. Desliza algunas fotos para mantener tu biblioteca limpia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des photos attendent votre examen. Parcourez quelques photos pour garder votre photothèque propre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai delle foto in attesa di revisione. Scorri alcune foto per mantenere la tua libreria in ordine."
